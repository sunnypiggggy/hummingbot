FROM python:3.12-slim

WORKDIR /app
COPY live_guard/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY scripts/grid_live_common.py /app/grid_live_common.py
COPY scripts/grid_technical_gate.py /app/grid_technical_gate.py
COPY scripts/dca_live_common.py /app/dca_live_common.py
COPY live_guard/dca_live_guard.py /app/dca_live_guard.py
COPY live_guard/grid_live_guard.py /app/grid_live_guard.py

CMD ["python", "/app/grid_live_guard.py"]
