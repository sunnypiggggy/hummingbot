# Copy this file to .env.control and fill in secrets locally.
# Do not commit .env.control.

HUMMINGBOT_API_USERNAME=admin
HUMMINGBOT_API_PASSWORD=replace-with-a-long-random-password
HUMMINGBOT_API_CONFIG_PASSWORD=replace-with-a-second-long-random-password
POSTGRES_USER=hbot
POSTGRES_PASSWORD=replace-with-a-third-long-random-password
POSTGRES_DB=hummingbot_api

# Exact environment variables read by the official API image.
USERNAME=admin
PASSWORD=replace-with-a-long-random-password
CONFIG_PASSWORD=replace-with-a-second-long-random-password
BROKER_HOST=emqx
DATABASE_URL=postgresql+asyncpg://hbot:replace-with-a-third-long-random-password@postgres:5432/hummingbot_api

# Create a new token in BotFather before using it here.
TELEGRAM_TOKEN=
ADMIN_USER_ID=

# One-way channel notifications. This is a different Bot from Hermes. Keep the
# Token in the host file below; never put it in this env file.
TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_PROFIT_REPORT_ENABLED=true
TELEGRAM_NOTIFY_CHANNEL_ID=
TELEGRAM_NOTIFY_BOT_TOKEN_PATH=/home/ubuntu/secrets/telegram_notify_bot_token
# Host-side v22 stage/approval commands append to this same mounted event log.
TELEGRAM_NOTIFICATION_EVENTS_PATH=/home/ubuntu/hummingbot/dca-live-data/telegram_events.jsonl
TELEGRAM_ALERT_V22_WEEKLY_BUY_GATE_ENABLED=true
TELEGRAM_ALERT_FOMC_GATE_ENABLED=true
TELEGRAM_ALERT_STRATEGY_LOSS_BREAKER_ENABLED=true
TELEGRAM_ALERT_STRATEGY_DRAWDOWN_BREAKER_ENABLED=true
TELEGRAM_ALERT_PORTFOLIO_LOSS_BREAKER_ENABLED=true
TELEGRAM_ALERT_PORTFOLIO_DRAWDOWN_BREAKER_ENABLED=true
TELEGRAM_ALERT_POSITION_PROTECTION_ENABLED=true

# Optional Condor AI features.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# MCP talks to the API from inside Docker.
HUMMINGBOT_API_URL=http://hummingbot-api:8000
HUMMINGBOT_USERNAME=admin
HUMMINGBOT_PASSWORD=replace-with-a-long-random-password

# Portfolio-grid scheduler. These defaults use paper trading only.
PORTFOLIO_PAIR_LIMIT=10
PORTFOLIO_INITIAL_QUOTE=10000

# Live BTC/ETH DCA. Keep false until the encrypted Binance credential,
# balances, IP allowlist, and dry-run preflight have all been verified.
DCA_LIVE_TRADING_ENABLED=false
DCA_LIVE_GUARD_INTERVAL=2
DCA_LIVE_FAIL_CLOSED_SECONDS=60
DCA_LIVE_REPORT_INTERVAL=300
DCA_LIVE_RUNTIME_IMAGE=hummingbot/dca-live-runtime:local
DCA_RISK_V22_WEEKLY_GATE_ENABLED=true
DCA_RISK_FOMC_GATE_ENABLED=true
DCA_RISK_STRATEGY_LOSS_BREAKER_ENABLED=true
DCA_RISK_STRATEGY_DRAWDOWN_BREAKER_ENABLED=true
DCA_RISK_PORTFOLIO_LOSS_BREAKER_ENABLED=true
DCA_RISK_PORTFOLIO_DRAWDOWN_BREAKER_ENABLED=true
DCA_RISK_POSITION_PROTECTION_ENABLED=true
DCA_RISK_AUTO_REENTRY_ENABLED=true
DCA_STRATEGY_DRAWDOWN_LIMIT_PCT=0.08
DCA_PORTFOLIO_DRAWDOWN_LIMIT_PCT=0.08
ACCOUNT_INVENTORY_UNATTRIBUTED_AUTO_LIQUIDATE_ENABLED=true
ACCOUNT_INVENTORY_CONFIRMATION_CYCLES=3
ACCOUNT_INVENTORY_CONFIRMATION_SECONDS=30
ACCOUNT_INVENTORY_BOOTSTRAP_BTC_CAP=0.001554857672861421803102676728
ACCOUNT_INVENTORY_BOOTSTRAP_ETH_CAP=0.00227157909293506300096269939
# Host-only JSON file with api_key/api_secret for Guard's independent Binance
# emergency channel. Never place this file in the repository. The key must
# have spot-trading permission, no withdrawal permission, and an OCI IP allowlist.
DCA_BINANCE_EMERGENCY_CREDENTIALS_PATH=/home/ubuntu/secrets/dca_binance_emergency_credentials.json

# Hermes DCA macro-control gateway. Keep execution disabled through shadow mode.
DCA_MACRO_EXECUTION_ENABLED=false
DCA_MACRO_ALLOWED_EVENTS=fomc,cpi,nfp
DCA_MACRO_MAX_PRE_EVENT_HOURS=24
DCA_MACRO_MAX_POST_EVENT_HOURS=6
DCA_MACRO_RECONCILE_INTERVAL=5
GRID_LIVE_MACRO_MAX_AGE_SECONDS=150
GRID_LIVE_FOMC_EXECUTION_ENABLED=false
GRID_RISK_V22_WEEKLY_GATE_ENABLED=true
GRID_RISK_FOMC_GATE_ENABLED=true
GRID_RISK_STRATEGY_LOSS_BREAKER_ENABLED=true
GRID_RISK_STRATEGY_DRAWDOWN_BREAKER_ENABLED=true
GRID_RISK_PORTFOLIO_LOSS_BREAKER_ENABLED=true
GRID_RISK_PORTFOLIO_DRAWDOWN_BREAKER_ENABLED=true
GRID_RISK_POSITION_PROTECTION_ENABLED=true
V22_WEEKLY_AUTO_UPDATE_ENABLED=true
V22_WEEKLY_DEFAULT_APPROVAL_DELAY_SECONDS=43200
V22_WEEKLY_GENERATION_LEAD_SECONDS=57600
V22_RUNTIME_ROOT=/workspace/state/v22-runtime
HERMES_DCA_DOMAIN=trading-control.sunnypiggy.fun
# Absolute host path to a JSON key-id -> HMAC-secret map. Do not commit it.
HERMES_HMAC_SECRETS_PATH=/home/ubuntu/secrets/hermes_hmac_secrets.json
# Hermes gateway must allow only this owner/private chat to approve decisions.
HERMES_APPROVER_TELEGRAM_USER_ID=
HERMES_APPROVER_TELEGRAM_CHAT_ID=
# Native Hermes clarify surface: telegram, cli, or dashboard.
HERMES_CONVERSATION_SURFACE=telegram

# FDUSD BTC/ETH live grid. This task only prepares a disabled deployment.
# Do not change this value until a new GO report and explicit approval exist.
GRID_LIVE_TRADING_ENABLED=false
GRID_LIVE_GUARD_SHADOW=true
GRID_V22_EXECUTION_MODE=observe
GRID_LIVE_PARAMETER_UPDATES_ENABLED=false
GRID_LIVE_GUARD_INTERVAL=2
GRID_LIVE_FAIL_CLOSED_SECONDS=60
GRID_ROC_BUY_GUARD_REFRESH_SECONDS=60
GRID_ROC_RISK_OFF_PCT=-5
GRID_SQZMOM_RISK_OFF_PCT=-1
GRID_BINANCE_EMERGENCY_CREDENTIALS_PATH=/home/ubuntu/secrets/grid_binance_emergency_credentials.json
