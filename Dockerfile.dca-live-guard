FROM python:3.12-slim

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY live_guard/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY scripts/dca_live_common.py /app/dca_live_common.py
COPY scripts/risk_recovery.py /app/risk_recovery.py
COPY scripts/grid_xgboost_risk_gate.py /app/grid_xgboost_risk_gate.py
COPY scripts/ethbtc_forced_exit_contract.py /app/ethbtc_forced_exit_contract.py
COPY scripts/deploy_dca_live.py /app/deploy_dca_live.py
COPY controllers/market_making/dman_maker_v3_macro.py /app/dman_maker_v3_macro.py
COPY live_guard/dca_live_guard.py /app/dca_live_guard.py
COPY live_guard/account_inventory.py /app/account_inventory.py
COPY live_guard/emergency_execution.py /app/emergency_execution.py
COPY live_guard/runtime_endpoints.py /app/runtime_endpoints.py
COPY live_guard/dca_live_report.py /app/dca_live_report.py
COPY live_guard/telegram_notifications.py /app/telegram_notifications.py
COPY live_guard/telegram_parameter_report.py /app/telegram_parameter_report.py
COPY live_guard/trading_status.py /app/trading_status.py
COPY live_guard/management_parameters.py /app/management_parameters.py
COPY scripts/render_v22_backtest_png_windows.py /app/render_v22_backtest_png_windows.py

CMD ["python", "/app/dca_live_guard.py"]
